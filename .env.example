# Supabase Configuration
# Optional: If not provided, the application automatically runs in Standalone Demo Mode 
# with local atomic state management and cross-tab Realtime synchronization via BroadcastChannel.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# MapLibre Vector Tile Style
# Default is OpenFreeMap Liberty style (100% free, no API key needed, has 3D buildings)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
